{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "ui-study-path",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "STUDY_KV",
      "id": "f6b4ed2ad2784c46b1832e492361a799"
    }
  ]
}
